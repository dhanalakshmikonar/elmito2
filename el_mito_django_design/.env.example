# Copy to .env for local use. Never commit .env or production secrets.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
SITE_URL=http://localhost:8000

# Optional shared product media storage. Use the same bucket settings locally
# and on Render if local admin uploads must be visible to the live storefront.
MEDIA_STORAGE=filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_AUTH=True

# Razorpay dashboard API credentials (test keys locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP delivery for account and order verification codes
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=EL MITO <no-reply@example.com>
ORDER_OTP_STAGE=before_payment

# Render deployment: set DEBUG=False, ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS,
# SECRET_KEY, DATABASE_URL, Razorpay credentials and persistent MEDIA_ROOT.
